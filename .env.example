# ---- Required ----
ANTHROPIC_API_KEY=

# ---- Model + cost knobs ----
# Default model for every channel. Sonnet keeps it cheap; swap to claude-opus-5 for depth.
GARRETT_MODEL=claude-sonnet-5
# low | medium | high. Lower = faster + cheaper.
GARRETT_EFFORT=medium
# Free questions per visitor (per IP, 30-day window) before the access form.
WEB_FREE_QUESTIONS=5
# Global ceiling on anonymous web chat.
WEB_MESSAGES_GLOBAL_PER_DAY=1500

# ---- Live data (optional) ----
# Local SEO Data REST API key (sk_live_...). Leave blank to answer from experience only.
LOCALSEODATA_API_KEY=
# Live-data credit budgets: per paying customer per month, and for all free visitors per day.
LSD_CREDITS_PER_MEMBER_PER_MONTH=1500
LSD_CREDITS_ANON_PER_DAY=2000

# ---- Storage (optional in dev, required in prod) ----
# Upstash Redis (or Vercel KV, which exposes KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Access requests ----
# Slack incoming webhook that pings you when someone asks for access (optional).
ACCESS_NOTIFY_WEBHOOK_URL=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Signing secret of the email.received webhook (starts with whsec_).
RESEND_WEBHOOK_SECRET=

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAMS=
# Fair-use cap for paying members.
MEMBER_QUESTIONS_PER_MONTH=300
# Long random string. Signs sign-in links and the member cookie.
SESSION_SECRET=

# ---- Slack app ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional: a bot token for your own workspace so you can test without the OAuth install.
SLACK_BOT_TOKEN=

# ---- Invites ----
# Long random string. Signs the install links you hand out (npm run invite).
INVITE_SECRET=
# Public origin, used to build links.
SITE_URL=http://localhost:3000
